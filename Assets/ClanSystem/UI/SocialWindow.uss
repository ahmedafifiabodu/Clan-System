.root {
    flex-grow: 1;
    background-color: rgb(16, 18, 26);
    color: rgb(228, 232, 240);
    font-size: 14px;
}

/* ---------- Sign-in ---------- */

.signin-panel {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.signin-title {
    font-size: 42px;
    -unity-font-style: bold;
    color: rgb(120, 190, 255);
    letter-spacing: 6px;
}

.signin-subtitle {
    font-size: 14px;
    color: rgb(140, 150, 170);
    margin-bottom: 24px;
}

.signin-card {
    width: 420px;
    padding: 20px;
    background-color: rgb(24, 28, 40);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgb(44, 52, 72);
}

/* ---------- Layout ---------- */

.main-panel {
    flex-grow: 1;
    display: none;
}

/* Fixed chrome. Both this and .tabbar defaulted to flex-shrink: 1, so a tall page below squeezed
   them vertically - the header rendered 47px tall while its content needed 72px, which clipped the
   player name and pushed the meta line down into the tab bar. Only .content yields now. */
.header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
    padding: 12px 18px;
    background-color: rgb(22, 26, 38);
    border-bottom-width: 1px;
    border-bottom-color: rgb(44, 52, 72);
}

/* The identity block is the only part of the header allowed to yield. Both sides defaulted to
   flex-shrink: 1, so a narrow window squeezed the name column while its labels kept their full
   text - and UI Toolkit does not clip overflow, so the name painted straight over the rename
   field. min-width: 0 is what lets a flex child shrink below its content at all. */
.header-identity {
    flex-direction: column;
    flex-shrink: 1;
    min-width: 0;
}

.header-name {
    font-size: 18px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.header-meta {
    font-size: 12px;
    color: rgb(140, 150, 170);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Fixed chrome: these controls are the same size at every window width, so they must not be the
   thing that shrinks. */
.header-actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.tabbar {
    flex-direction: row;
    flex-shrink: 0;
    background-color: rgb(20, 23, 34);
    padding: 6px 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(44, 52, 72);
}

.tab {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
    color: rgb(150, 158, 178);
    padding: 8px 16px;
    font-size: 14px;
}

.tab:hover {
    color: rgb(220, 228, 245);
}

.tab.selected {
    color: rgb(120, 190, 255);
    border-bottom-color: rgb(120, 190, 255);
    -unity-font-style: bold;
}

/* The one row that absorbs a short window. min-height: 0 lets it shrink below its content, which
   a flex child cannot do by default - without it the page would push the chrome off instead. */
.content {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.page {
    flex-grow: 1;
    padding: 16px;
    display: none;
}

.page.visible {
    display: flex;
}

.row-split {
    flex-direction: row;
    flex-grow: 1;
}

.column {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 12px;
}

.column.narrow {
    flex-grow: 0;
    flex-basis: 320px;
    margin-right: 0;
}

.section-title {
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(130, 140, 160);
    margin-bottom: 6px;
    margin-top: 6px;
}

/* ---------- Controls ---------- */

.button {
    background-color: rgb(38, 44, 62);
    border-width: 1px;
    border-color: rgb(56, 64, 86);
    border-radius: 6px;
    color: rgb(224, 230, 245);
    padding: 6px 14px;
    margin-left: 6px;
}

.button:hover {
    background-color: rgb(48, 56, 78);
}

.button.primary {
    background-color: rgb(48, 110, 200);
    border-color: rgb(70, 140, 235);
}

.button.primary:hover {
    background-color: rgb(60, 128, 225);
}

.button.danger {
    background-color: rgb(120, 44, 52);
    border-color: rgb(165, 62, 72);
}

.button.ghost {
    background-color: rgba(0, 0, 0, 0);
}

.button.wide {
    margin-top: 10px;
    margin-left: 0;
    align-self: stretch;
}

.button.mini {
    padding: 3px 9px;
    font-size: 11px;
}

.button:disabled {
    opacity: 0.45;
}

.text-field {
    min-width: 120px;
    margin-bottom: 6px;
}

/* The runtime theme ships light input chrome; restyle the inner input to match the panel. */
.unity-base-text-field__input {
    background-color: rgb(28, 33, 47);
    border-color: rgb(56, 64, 86);
    border-width: 1px;
    border-radius: 6px;
    color: rgb(228, 232, 240);
    padding: 5px 8px;
    --unity-cursor-color: rgb(120, 190, 255);
    --unity-selection-color: rgba(48, 110, 200, 0.55);
}

.unity-base-text-field__input:focus {
    border-color: rgb(70, 140, 235);
}

.unity-base-field__label {
    color: rgb(150, 158, 178);
}

.unity-toggle__checkmark {
    background-color: rgb(28, 33, 47);
    border-color: rgb(56, 64, 86);
}

.text-field.grow {
    flex-grow: 1;
    margin-bottom: 0;
}

.text-field.small {
    width: 150px;
    margin-bottom: 0;
}

.text-field.tiny {
    width: 90px;
    margin-left: 6px;
    margin-bottom: 0;
}

.text-field.area {
    min-height: 54px;
}

.toggle {
    margin-top: 6px;
}

.field-label {
    font-size: 12px;
    color: rgb(150, 158, 178);
    margin-bottom: 4px;
}

.hint {
    font-size: 11px;
    color: rgb(120, 130, 152);
    margin-top: 4px;
    margin-bottom: 6px;
    white-space: normal;
}

/* Sign-in progress. Hidden until sign-in starts; SocialBootstrap toggles it. */
.signin-progress {
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
    display: none;
}

/* Ring with one bright quadrant. UI Toolkit has no keyframes, so SocialBootstrap advances the
   rotation on a scheduler tick - the arc is what makes that rotation visible. */
.spinner {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(52, 62, 86);
    border-top-color: rgb(96, 165, 250);
    flex-shrink: 0;
}

.signin-stage {
    font-size: 12px;
    color: rgb(150, 162, 186);
    margin-left: 10px;
    white-space: normal;
    flex-shrink: 1;
}

.status-line {
    font-size: 12px;
    color: rgb(235, 140, 140);
    margin-top: 8px;
    white-space: normal;
}

.inline-form {
    flex-direction: row;
    align-items: center;
}

.card {
    background-color: rgb(24, 28, 40);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgb(44, 52, 72);
    padding: 14px;
    margin-bottom: 12px;
}

.card-title {
    -unity-font-style: bold;
    margin-bottom: 8px;
}

/* ---------- Lists ---------- */

.list {
    flex-grow: 1;
    min-height: 120px;
    max-height: 260px;
    background-color: rgb(20, 23, 34);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(40, 46, 64);
}

.list.tall {
    max-height: 380px;
}

.row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 8px 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(32, 37, 52);
}

.row:hover {
    background-color: rgb(28, 33, 47);
}

.row.self {
    background-color: rgba(48, 110, 200, 0.18);
}

.row-main {
    flex-direction: column;
    flex-grow: 1;
}

.row-title {
    font-size: 13px;
}

.row-sub {
    font-size: 11px;
    color: rgb(130, 140, 162);
}

.row-actions {
    flex-direction: row;
    align-items: center;
}

.presence-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 8px;
    background-color: rgb(90, 98, 118);
}

.presence-dot.online {
    background-color: rgb(90, 205, 130);
}

.badge {
    font-size: 10px;
    -unity-font-style: bold;
    padding: 2px 6px;
    border-radius: 4px;
    background-color: rgb(44, 52, 72);
    color: rgb(180, 200, 230);
    margin-left: 6px;
}

.badge.owner {
    background-color: rgb(150, 110, 30);
    color: rgb(255, 240, 210);
}

.badge.officer {
    background-color: rgb(60, 90, 140);
    color: rgb(215, 232, 255);
}

.empty-state {
    font-size: 12px;
    color: rgb(110, 120, 142);
    padding: 10px 4px;
    -unity-font-style: italic;
}

/* ---------- Clan ---------- */

.clan-none {
    flex-grow: 1;
    display: none;
}

.clan-none.visible {
    display: flex;
}

.clan-detail {
    flex-grow: 1;
    display: none;
}

.clan-detail.visible {
    display: flex;
}

.clan-banner {
    flex-direction: row;
    align-items: center;
    background-color: rgb(24, 28, 40);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgb(44, 52, 72);
    padding: 14px;
    margin-bottom: 10px;
}

.emblem {
    width: 56px;
    height: 56px;
    border-radius: 10px;
    background-color: rgb(48, 110, 200);
    margin-right: 14px;
}

.clan-headline {
    flex-grow: 1;
}

.clan-name {
    font-size: 20px;
    -unity-font-style: bold;
}

.clan-sub {
    font-size: 12px;
    color: rgb(140, 150, 170);
}

.clan-description {
    font-size: 12px;
    color: rgb(170, 180, 200);
    white-space: normal;
    margin-top: 4px;
}

.clan-stats {
    align-items: flex-end;
}

.stat {
    font-size: 12px;
    color: rgb(180, 195, 220);
}

.motd-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.clan-actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 10px;
}

/* ---------- Chat ---------- */

.subtabs {
    flex-direction: row;
    margin-bottom: 8px;
}

.subtab {
    background-color: rgb(28, 33, 47);
    border-width: 1px;
    border-color: rgb(44, 52, 72);
    border-radius: 6px;
    color: rgb(160, 170, 190);
    padding: 5px 14px;
    margin-right: 6px;
    /* Keep each tab at its label width; shrinking makes the labels bleed past their own borders
       and into the neighbouring tab. */
    flex-shrink: 0;
}

.subtab.selected {
    background-color: rgb(48, 110, 200);
    color: rgb(240, 246, 255);
}

.chat-list {
    flex-grow: 1;
    /* The one row that yields when the page is short. A large minimum here would instead force the
       fixed chrome above and below off the page. */
    flex-shrink: 1;
    min-height: 120px;
    background-color: rgb(20, 23, 34);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(40, 46, 64);
    padding: 6px;
}

.chat-line {
    flex-direction: column;
    padding: 4px 6px;
}

.chat-meta {
    font-size: 10px;
    color: rgb(120, 130, 152);
}

.chat-text {
    font-size: 13px;
    white-space: normal;
}

.chat-line.mine .chat-meta {
    color: rgb(120, 190, 255);
}

.chat-input-row {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
    flex-shrink: 0;
}

/* ---------- Voice ---------- */

/* The chat page is one row: conversation on the left, voice rail on the right. Only the
   conversation column yields when the window narrows - UI Toolkit does not clip overflow, so a
   squeezed fixed-width rail would paint its controls over the messages. */
.chat-split {
    flex-direction: row;
    flex-grow: 1;
}

.chat-column {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 220px;
}

.voice-rail {
    width: 268px;
    flex-shrink: 0;
    flex-direction: column;
    margin-left: 12px;
    padding: 10px;
    background-color: rgb(24, 28, 40);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(44, 52, 72);
}

.voice-rail-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
    flex-shrink: 0;
}

/* Segmented control. Two mutually exclusive destinations read as one control, where two separate
   buttons read as two unrelated actions. */
.segmented {
    flex-direction: row;
    margin-bottom: 10px;
    flex-shrink: 0;
}

.seg {
    flex-grow: 1;
    flex-basis: 0;
    background-color: rgb(28, 33, 47);
    border-width: 1px;
    border-color: rgb(44, 52, 72);
    color: rgb(160, 170, 190);
    padding: 6px 0;
    margin: 0;
    border-radius: 0;
}

.seg:hover {
    background-color: rgb(36, 42, 60);
}

.seg:disabled {
    opacity: 0.4;
}

/* UI Toolkit has no :first-child / :last-child, so the ends of the segmented control are marked
   explicitly in the UXML. */
.seg.seg-left {
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
}

.seg.seg-right {
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-left-width: 0;
}

.seg.selected {
    background-color: rgb(48, 110, 200);
    border-color: rgb(70, 140, 235);
    color: rgb(240, 246, 255);
}

/* The rail's only flexible row, so the dock below it can never be pushed off the page. The empty
   state is laid over the list rather than stacked under it: below the list it left a large empty
   box with a caption beneath, which reads as a broken panel rather than as an empty one. */
.voice-list-wrap {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 60px;
}

.voice-empty {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 12px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.voice-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 60px;
    max-height: none;
}

/* Stacked, not side by side. The rail is 268px wide: a name, a mute button and a volume slider on
   one line cannot all have their minimum width, and flexbox resolves that by letting them overlap
   rather than by wrapping. Name on top, controls underneath, each with room to be read. */
.voice-row {
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    padding: 6px 8px;
}

.voice-row.speaking {
    background-color: rgba(90, 205, 130, 0.14);
}

.voice-row-head {
    flex-direction: row;
    align-items: center;
}

/* Shrinks and ellipsises instead of pushing the controls out of the rail. */
.voice-row-name {
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.voice-row-controls {
    flex-direction: row;
    align-items: center;
    /* Indented to the dot's width, so the controls read as belonging to the name above them. */
    margin-left: 17px;
    margin-top: 5px;
}

.voice-mute {
    /* Fixed, because "Mute" and "Unmute" are different widths and the slider must not shuffle
       sideways every time the state changes. */
    width: 58px;
    margin-left: 0;
    padding: 3px 0;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.voice-mute.muted {
    background-color: rgb(120, 44, 52);
    border-color: rgb(165, 62, 72);
}

.voice-volume-value {
    width: 34px;
    font-size: 10px;
    color: rgb(140, 150, 172);
    -unity-text-align: middle-right;
    flex-shrink: 0;
}

.speaking-dot {
    width: 9px;
    height: 9px;
    border-radius: 5px;
    margin-right: 8px;
    background-color: rgb(70, 78, 98);
    flex-shrink: 0;
}

.speaking-dot.active {
    background-color: rgb(90, 205, 130);
}

.volume-slider {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 40px;
    margin-left: 8px;
    margin-right: 4px;
}

.volume-slider:disabled {
    opacity: 0.4;
}

/* ---------- Voice dock ---------- */

/* The right padding reserves the bottom-right corner for the floating notification button, which
   parks there by default. Reserved permanently rather than only while the button is in the corner:
   the button is draggable, and a dock that reflowed every time it moved would be worse than a
   dock that is simply 62px narrower. */
.voice-dock {
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
    padding-top: 10px;
    padding-right: 62px;
    border-top-width: 1px;
    border-top-color: rgb(44, 52, 72);
    flex-shrink: 0;
}

/* 44px is the smallest comfortable touch target, and the same size works for a mouse. Mic and
   speaker are the same size because neither is the secondary of the pair. */
.icon-button {
    width: 44px;
    height: 44px;
    margin: 0 8px 0 0;
    padding: 0;
    background-color: rgb(38, 44, 62);
    border-width: 1px;
    border-color: rgb(56, 64, 86);
    border-radius: 8px;
    align-items: center;
    justify-content: center;
}

.icon-button:hover {
    background-color: rgb(48, 56, 78);
}

.icon-button:disabled {
    opacity: 0.35;
}

/* State is carried by colour AND by the slash overlay, so it survives colour-blindness and a
   greyscale screenshot. Text is never the only signal. */
.icon-button.on {
    background-color: rgba(52, 150, 96, 0.22);
    border-color: rgb(70, 180, 118);
}

.icon-button.off {
    background-color: rgba(170, 60, 68, 0.25);
    border-color: rgb(196, 78, 88);
}

/* Speaking outline. Brighter than the idle "on" border so the meter is not the only cue that the
   transport is hearing the player. */
.icon-button.live {
    border-color: rgb(120, 235, 160);
}

.icon {
    width: 24px;
    height: 24px;
}

.icon-button.on .icon {
    opacity: 1;
}

.icon-button.off .icon {
    opacity: 0.75;
}

/* Slash for the muted state, drawn over the icon. Hidden unless the button is off. */
.icon-slash {
    position: absolute;
    width: 30px;
    height: 2px;
    border-radius: 1px;
    background-color: rgb(255, 168, 172);
    rotate: -45deg;
    display: none;
}

.icon-button.off .icon-slash {
    display: flex;
}

/* ---------- Icon glyphs ----------
   Drawn from elements rather than shipped as textures: the project has no icon set, and two
   glyphs do not justify introducing an art pipeline and its import settings. Children are
   absolutely positioned inside the 24x24 .icon box. */

.icon-mic {
    align-items: center;
}

.mic-capsule {
    position: absolute;
    top: 2px;
    left: 8px;
    width: 8px;
    height: 12px;
    border-radius: 4px;
    background-color: rgb(226, 234, 248);
}

/* Open-bottom ring: the cradle the capsule sits in. */
.mic-arc {
    position: absolute;
    top: 9px;
    left: 4px;
    width: 16px;
    height: 9px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-top-width: 0;
    border-color: rgb(226, 234, 248);
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.mic-stem {
    position: absolute;
    top: 18px;
    left: 11px;
    width: 2px;
    height: 3px;
    background-color: rgb(226, 234, 248);
}

.mic-base {
    position: absolute;
    top: 21px;
    left: 7px;
    width: 10px;
    height: 2px;
    border-radius: 1px;
    background-color: rgb(226, 234, 248);
}

.icon-button.on .mic-capsule,
.icon-button.on .mic-stem,
.icon-button.on .mic-base {
    background-color: rgb(150, 240, 186);
}

.icon-button.on .mic-arc {
    border-color: rgb(150, 240, 186);
}

.icon-button.off .mic-capsule,
.icon-button.off .mic-stem,
.icon-button.off .mic-base {
    background-color: rgb(255, 168, 172);
}

.icon-button.off .mic-arc {
    border-color: rgb(255, 168, 172);
}

.icon-speaker {
    align-items: center;
}

.spk-body {
    position: absolute;
    top: 8px;
    left: 2px;
    width: 5px;
    height: 8px;
    background-color: rgb(226, 234, 248);
}

/* Triangle via the border trick: a zero-size box whose right border is the only opaque one
   collapses into a left-pointing wedge. */
.spk-cone {
    position: absolute;
    top: 4px;
    left: 6px;
    width: 0;
    height: 0;
    border-top-width: 8px;
    border-bottom-width: 8px;
    border-right-width: 6px;
    border-left-width: 0;
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    border-right-color: rgb(226, 234, 248);
}

/* Crescents: only the right edge of a rounded box is drawn, which reads as a radiating arc. */
.spk-wave {
    position: absolute;
    border-right-width: 2px;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-color: rgb(226, 234, 248);
}

.spk-wave.near {
    top: 8px;
    left: 12px;
    width: 5px;
    height: 8px;
    border-radius: 4px;
}

.spk-wave.far {
    top: 5px;
    left: 14px;
    width: 7px;
    height: 14px;
    border-radius: 7px;
}

.icon-button.on .spk-body,
.icon-button.on .spk-cone {
    border-right-color: rgb(150, 240, 186);
    background-color: rgb(150, 240, 186);
}

.icon-button.on .spk-wave {
    border-color: rgb(150, 240, 186);
}

.icon-button.off .spk-body {
    background-color: rgb(255, 168, 172);
}

.icon-button.off .spk-cone {
    border-right-color: rgb(255, 168, 172);
}

/* Incoming audio is off, so radiating waves would be a lie. */
.icon-button.off .spk-wave {
    display: none;
}

/* ---------- Microphone level ----------
   Driven by the transport's own measured audio energy. Sits inside the mic button as a rising
   floor rather than beside it as a separate widget, so level and mute state are one object. */
.mic-meter {
    position: absolute;
    bottom: 3px;
    left: 5px;
    width: 34px;
    height: 3px;
    border-radius: 2px;
    background-color: rgba(120, 140, 170, 0.28);
    overflow: hidden;
    display: none;
}

.icon-button.on .mic-meter {
    display: flex;
}

.mic-meter-fill {
    width: 0;
    height: 3px;
    border-radius: 2px;
    background-color: rgb(110, 225, 158);
}

.dock-leave {
    margin-left: auto;
    margin-right: 0;
    font-size: 12px;
    padding: 6px 10px;
}

/* ---------- Chat head ---------- */

.chat-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
}

.section-title.flush {
    margin-top: 0;
    margin-bottom: 0;
}

.conn-pill {
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    padding: 3px 8px;
    border-radius: 4px;
    background-color: rgb(44, 52, 72);
    color: rgb(160, 170, 190);
}

.conn-pill.online {
    background-color: rgba(90, 205, 130, 0.2);
    color: rgb(120, 220, 160);
}

.conn-pill.error {
    background-color: rgba(200, 80, 90, 0.25);
    color: rgb(240, 150, 150);
}

/* ---------- Narrow layout ----------
   USS has no media queries, so SocialWindowController toggles this class from the page's own
   width. Below the breakpoint the rail becomes a compact strip above the conversation: the
   participant list collapses, and the dock stays, because mute is the control a player needs
   most on a small screen. */
/* column-reverse, not column: UI Toolkit has no flex `order`, and the rail is the second child.
   Reversing is what lifts it above the conversation - stacked the other way it lands under the
   message input, which puts the mute button below the thing the player is typing into. */
.chat-split.narrow {
    flex-direction: column-reverse;
}

.chat-split.narrow .voice-rail {
    width: auto;
    margin-left: 0;
    margin-bottom: 8px;
    flex-shrink: 0;
}

/* The wrapper is what flexes, so hiding only the list inside it would leave the rail holding an
   empty 200px of nothing. */
.chat-split.narrow .voice-list-wrap {
    display: none;
}

.chat-split.narrow .voice-dock {
    margin-top: 0;
    padding-top: 0;
    border-top-width: 0;
}

/* ---------- Emoji picker ---------- */

.emoji-picker {
    display: none;
    background-color: rgb(24, 28, 40);
    border-width: 1px;
    border-color: rgb(56, 64, 86);
    border-radius: 8px;
    padding: 8px;
    margin-top: 8px;
    max-height: 200px;
    /* Chrome, like the rows above: without this the picker is squeezed flat when it opens and the
       emoji grid is clipped to a sliver. */
    flex-shrink: 0;
}

.emoji-picker.visible {
    display: flex;
}

.emoji-categories {
    flex-direction: row;
    margin-bottom: 6px;
}

.emoji-category {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
    font-size: 18px;
    padding: 2px 10px;
}

.emoji-category.selected {
    border-bottom-color: rgb(120, 190, 255);
}

.emoji-grid {
    max-height: 140px;
}

/* Two levels below the ScrollView (content-viewport, then this), not a direct child. */
.emoji-grid .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
}

.emoji-button {
    font-size: 20px;
    width: 40px;
    height: 36px;
    margin: 2px;
    padding: 0;
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
    border-radius: 6px;
}

.emoji-button:hover {
    background-color: rgba(120, 190, 255, 0.2);
}

/* ---------- Leaderboards ---------- */

.lb-header {
    flex-direction: row;
    padding: 6px 10px;
    background-color: rgb(24, 28, 40);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

.lb-cell {
    font-size: 11px;
    color: rgb(140, 150, 172);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.lb-rank {
    width: 60px;
}

.lb-name {
    flex-grow: 1;
}

.lb-value {
    width: 110px;
    -unity-text-align: middle-right;
}

.lb-self {
    margin-top: 8px;
}

.pager {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 8px;
}

.page-label {
    font-size: 12px;
    color: rgb(150, 160, 180);
    margin: 0 10px;
}

/* ---------- Feedback ---------- */

.busy-bar {
    height: 3px;
    background-color: rgb(120, 190, 255);
    display: none;
}

.busy-bar.visible {
    display: flex;
}

.busy-label {
    display: none;
}

/* Top centre, and centred by translation rather than by a hardcoded offset, so it holds its
   position at every window width. It sits over the header's empty middle - the identity block is
   left-aligned and the actions are right-aligned - so nothing it covers is interactive.
   Visibility rather than display keeps the element laid out, which is what lets the slide and fade
   actually run; `display: none` has no geometry to animate from. */
.toast {
    position: absolute;
    top: 12px;
    left: 50%;
    translate: -50% -14px;
    max-width: 420px;
    padding: 10px 14px;
    border-radius: 8px;
    background-color: rgb(32, 40, 58);
    border-width: 1px;
    border-color: rgb(70, 140, 235);
    opacity: 0;
    visibility: hidden;
    transition-property: opacity, translate;
    transition-duration: 180ms, 220ms;
    transition-timing-function: ease-out, ease-out-back;
}

.toast.visible {
    opacity: 1;
    visibility: visible;
    translate: -50% 0;
}

.toast.error {
    border-color: rgb(200, 80, 90);
    background-color: rgb(56, 28, 34);
}

.toast-label {
    font-size: 13px;
    white-space: normal;
}

/* ---------- Popup ---------- */

.popup-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
    align-items: center;
    justify-content: center;
    display: none;
}

.popup-backdrop.visible {
    display: flex;
}

.popup {
    width: 380px;
    padding: 18px;
    background-color: rgb(24, 28, 40);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgb(70, 140, 235);
}

.popup-title {
    font-size: 18px;
    -unity-font-style: bold;
}

.popup-meta {
    font-size: 12px;
    color: rgb(150, 160, 182);
    margin-top: 4px;
    white-space: normal;
}

.popup-actions {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 12px;
}


/* ---------- Notification dock ---------- */

/* The floating button. Positioned in code from the window's own rect - never from fixed pixels -
   so it lands in the same visual corner at any resolution or aspect ratio, and is re-clamped when
   the window resizes. Its transform is animated, so `left`/`top` stay the authoritative position
   and the elastic motion rides on top of them without fighting the layout. */
/* Hidden until the player is signed in - SocialWindowController only exists past that point,
   and it is what turns this on. Without the default-hidden state the button sits over the
   sign-in screen, unowned by anything, well before there is a session for it to represent. */
.notif-dock {
    position: absolute;
    width: 56px;
    height: 56px;
    border-radius: 28px;
    background-color: rgb(38, 44, 62);
    border-width: 1px;
    border-color: rgb(70, 140, 235);
    align-items: center;
    justify-content: center;
    display: none;
    transition-property: scale, background-color;
    transition-duration: 120ms;
    transition-timing-function: ease-out;
}

.notif-dock:hover {
    background-color: rgb(48, 56, 78);
}

.notif-dock.pressed {
    scale: 0.92 0.92;
}

.notif-dock.dragging {
    scale: 1.06 1.06;
    border-color: rgb(120, 190, 255);
}

.icon-bell {
    width: 22px;
    height: 24px;
    align-items: center;
}

.bell-dome {
    width: 18px;
    height: 15px;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    background-color: rgb(226, 234, 250);
    margin-top: 2px;
}

.bell-rim {
    width: 22px;
    height: 3px;
    border-radius: 2px;
    background-color: rgb(226, 234, 250);
    margin-top: 1px;
}

.bell-clapper {
    width: 6px;
    height: 4px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    background-color: rgb(226, 234, 250);
    margin-top: 1px;
}

/* Child of the button, so it inherits every drag and every snap with no second position to keep
   in step. Pulled outside the button's own bounds by a negative offset. */
.notif-badge {
    position: absolute;
    top: -4px;
    right: -4px;
    min-width: 22px;
    height: 22px;
    border-radius: 11px;
    background-color: rgb(206, 54, 62);
    border-width: 2px;
    border-color: rgb(16, 18, 26);
    color: rgb(255, 245, 245);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0 4px;
    display: none;
}

.notif-badge.visible {
    display: flex;
}

/* ---------- Notification panel ---------- */

/* Anchored to the floating button from code - left, top and height are all written there - so
   the panel travels with the button instead of living at a corner of its own. */
.notif-panel {
    position: absolute;
    width: 420px;
    max-width: 92%;
    padding: 14px;
    border-radius: 12px;
    background-color: rgb(24, 28, 40);
    border-width: 1px;
    border-color: rgb(56, 64, 86);
    opacity: 0;
    visibility: hidden;
    scale: 0.94 0.94;
    transform-origin: bottom right;
    transition-property: opacity, scale;
    transition-duration: 140ms, 200ms;
    transition-timing-function: ease-out, ease-out-back;
}

.notif-panel.open {
    opacity: 1;
    visibility: visible;
    scale: 1 1;
}

.notif-panel-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.notif-panel-title {
    margin-bottom: 0;
}

.notif-tabs {
    margin-top: 8px;
    margin-bottom: 8px;
}

.notif-tab {
    flex-direction: row;
    align-items: center;
}

.notif-tab-label {
    font-size: 12px;
    color: rgb(200, 210, 228);
}

.notif-tab.selected .notif-tab-label {
    color: rgb(240, 246, 255);
}

.notif-tab-count {
    min-width: 18px;
    height: 18px;
    margin-left: 6px;
    border-radius: 9px;
    background-color: rgb(206, 54, 62);
    color: rgb(255, 245, 245);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0 3px;
    display: none;
}

.notif-tab-count.visible {
    display: flex;
}

/* One category is laid out at a time; the fade is what makes the switch read as a transition
   rather than a swap. */
.notif-category {
    flex-grow: 1;
    display: none;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 140ms;
}

.notif-category.visible {
    display: flex;
    opacity: 1;
}

.notif-list {
    max-height: none;
    flex-grow: 1;
}

.small-button {
    padding: 3px 10px;
    font-size: 11px;
}
